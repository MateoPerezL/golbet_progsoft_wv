@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model IEnumerable<GolBet.Services.DTOs.MatchDto>

@{
    ViewData["Title"] = "Partidos";

    MatchStatus? currentStatus =
        (MatchStatus?)ViewBag.CurrentStatus;

    string? currentSearch =
        ViewBag.CurrentSearch as string;

    string allButtonClass =
        currentStatus is null
            ? "btn-success"
            : "btn-outline-success";

    string scheduledButtonClass =
        currentStatus == MatchStatus.Scheduled
            ? "btn-success"
            : "btn-outline-success";

    string inProgressButtonClass =
        currentStatus == MatchStatus.InProgress
            ? "btn-success"
            : "btn-outline-success";

    string finishedButtonClass =
        currentStatus == MatchStatus.Finished
            ? "btn-success"
            : "btn-outline-success";
}

<div class="d-flex justify-content-between
    align-items-center mb-4">

    <h2 class="mb-0">
        Cartelera de partidos
    </h2>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create"
           class="btn btn-success">
            + Nuevo partido
        </a>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index"
              method="get">

            <div class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label for="search"
                           class="form-label">
                        Buscar por equipo
                    </label>

                    <input type="search"
                           id="search"
                           name="search"
                           value="@currentSearch"
                           class="form-control"
                           placeholder="Ejemplo: Nacional, Millonarios..." />
                </div>

                <div class="col-md-3 d-grid">
                    <button type="submit"
                            class="btn btn-primary">
                        Buscar
                    </button>
                </div>
            </div>

            @if (currentStatus.HasValue)
            {
                <input type="hidden"
                       name="status"
                       value="@currentStatus.Value" />
            }
        </form>
    </div>
</div>

<div class="d-flex gap-2 flex-wrap mb-4">
    <a asp-action="Index"
       asp-route-search="@currentSearch"
       class="btn btn-sm @allButtonClass">
        Todos
    </a>

    <a asp-action="Index"
       asp-route-status="@MatchStatus.Scheduled"
       asp-route-search="@currentSearch"
       class="btn btn-sm @scheduledButtonClass">
        Programados
    </a>

    <a asp-action="Index"
       asp-route-status="@MatchStatus.InProgress"
       asp-route-search="@currentSearch"
       class="btn btn-sm @inProgressButtonClass">
        En juego
    </a>

    <a asp-action="Index"
       asp-route-status="@MatchStatus.Finished"
       asp-route-search="@currentSearch"
       class="btn btn-sm @finishedButtonClass">
        Finalizados
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        @if (!string.IsNullOrWhiteSpace(currentSearch))
        {
            <p class="mb-3">
                No hay partidos para
                <strong>“@currentSearch”</strong>.
            </p>
        }
        else
        {
            <p class="mb-3">
                No hay partidos disponibles.
            </p>
        }

        <a asp-action="Index"
           class="btn btn-outline-primary">
            Volver a la cartelera de partidos
        </a>
    </div>
}
else
{
    <div class="row row-cols-1
        row-cols-md-2
        row-cols-xl-3
        g-4">

        @foreach (var match in Model)
        {
            var homeCrest =
                match.HomeTeamCrestUrl
                ?? "https://placehold.co/60x60/e9ecef/6c757d?text=FC";

            var awayCrest =
                match.AwayTeamCrestUrl
                ?? "https://placehold.co/60x60/e9ecef/6c757d?text=FC";

            <div class="col">
                <div class="card h-100 shadow-sm">

                    <div class="card-header d-flex
                        justify-content-between
                        align-items-center">

                        <small class="text-muted">
                            @(match.Date.ToColombiaTime()
                                .ToString(
                                    "ddd dd MMM yyyy · h:mm tt"))
                        </small>

                        @if (match.Status ==
                            MatchStatus.Scheduled)
                        {
                            <span class="badge bg-primary">
                                Programado
                            </span>
                        }
                        else if (match.Status ==
                                 MatchStatus.InProgress)
                        {
                            <span class="badge bg-warning text-dark">
                                En juego
                            </span>
                        }
                        else if (match.Status ==
                                 MatchStatus.Finished)
                        {
                            <span class="badge bg-secondary">
                                Finalizado
                            </span>
                        }
                    </div>

                    <div class="card-body">
                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            text-center">

                            <div class="w-100">
                                <img src="@homeCrest"
                                     alt="@match.HomeTeamName"
                                     width="60"
                                     height="60"
                                     class="mb-1" />

                                <div class="fw-bold small">
                                    @match.HomeTeamName
                                </div>
                            </div>

                            <div class="px-3 text-nowrap">
                                @if (match.Status ==
                                    MatchStatus.Finished)
                                {
                                    <span class="fs-3 fw-bold">
                                        @match.HomeGoals -
                                        @match.AwayGoals
                                    </span>
                                }
                                else
                                {
                                    <span class="fs-4 text-muted">
                                        vs
                                    </span>
                                }
                            </div>

                            <div class="w-100">
                                <img src="@awayCrest"
                                     alt="@match.AwayTeamName"
                                     width="60"
                                     height="60"
                                     class="mb-1" />

                                <div class="fw-bold small">
                                    @match.AwayTeamName
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <div class="row g-2 text-center">

                            <div class="col">
                                <div class="border rounded py-1">
                                    <small class="text-muted d-block">
                                        1 · Local
                                    </small>

                                    <span class="fw-bold">
                                        @match.HomeOdds.ToString("0.00")
                                    </span>
                                </div>
                            </div>

                            <div class="col">
                                <div class="border rounded py-1">
                                    <small class="text-muted d-block">
                                        X · Empate
                                    </small>

                                    <span class="fw-bold">
                                        @match.DrawOdds.ToString("0.00")
                                    </span>
                                </div>
                            </div>

                            <div class="col">
                                <div class="border rounded py-1">
                                    <small class="text-muted d-block">
                                        2 · Visitante
                                    </small>

                                    <span class="fw-bold">
                                        @match.AwayOdds.ToString("0.00")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <a asp-action="Detail"
                           asp-route-id="@match.Id"
                           class="btn btn-sm
                            btn-outline-secondary
                            w-100 mt-2">
                            Ver detalle
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
